{% extends 'checkout-base.html.twig' %}

{% block title %}
    {{ 'Finalisation Paiement - PayPal'|trans }}
{% endblock %}

{# No checkoutSteps override: checkout-base.html.twig draws the bar from `steps`, and this page
   is a stop of the payment step. #}

{% block checkoutContent %}
    <section class="Paypal">
         <div class="flex flex-col gap-5 container">
            <div class="Paypal-headers">
                <h1 class="h3 mb-4">
                    {{ infos.title }}
                </h1>

                {% if infos.description %}
                    <p class="paragraph-2">
                        {{ infos.description }}
                    </p>
                {% endif %}

                {% if infos.chapo %}
                    <p class="paragraph-2">
                        {{ infos.chapo }}
                    </p>
                {% endif %}

                {% if intent == 'subscription' %}
                    <p class="paragraph-2">
                        {{ "Vous avez choisi le mode :"|trans }}
                        <span>
                            {{ plan_title }} - {{ plan_description }}
                        </span>
                    </p>
                {% endif %}
            </div>
            <div class="Paypal-actions" style="">
                <div id="paypal-button-container"></div>
            </div>
        </div>
    </section>

    <script src="https://www.paypal.com/sdk/js?client-id={{ paypal_client_id }}&currency={{ currency }}&intent={{ intent }}&components=buttons&enable-funding=paylater,card{% if intent == 'subscription' %}&vault=true{% endif %}"></script>

    {% if intent == 'subscription' %}
        <script>
            async function createPaypalPlanifiedOrder(orderId, planifiedPaymentId)
            {
                try {
                    const response = await fetch("/paypal/api/pay", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({
                            order_id: orderId,
                            return_url: "{{ url('checkout_confirm') }}",
                            cancel_url: "{{ url('checkout_failed', {order_id: order_id}) }}",
                            planified_payment_id: planifiedPaymentId
                        }),
                    });

                    const order = await response.json();

                    if (!response.ok) {
                        console.error('Error:', order.error.message);
                        return null;
                    }

                    const parsedOrder = JSON.parse(order);
                    return parsedOrder.id;

                } catch (error) {
                    console.error('Error:', error);
                    return null;
                }
            }

            const orderId = {{ order_id }};
            const planifiedPaymentId = {{ planified_payment_id }};

            createPaypalPlanifiedOrder(orderId, planifiedPaymentId).then(planId => {
                if (planId) {

                    paypal.Buttons({
                        createSubscription: function (data, actions) {
                            return actions.subscription.create({
                                'plan_id': planId // Creates the subscription
                            });
                        },
                        onApprove: function (data, actions) {
                            window.location.href = "{{ path('checkout_confirm') }}";
                        }
                    }).render('#paypal-button-container'); // Renders the PayPal button

                } else {
                    console.error('Failed to create PayPal order');
                }
            });
        </script>
    {% else %}
        <script>
            const orderId = {{ order_id }};

            async function createPaypalOrder(orderId)
            {
                try {
                    const response = await fetch("/paypal/api/pay", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({
                            order_id: orderId,
                            return_url: "{{ url('checkout_confirm') }}",
                            cancel_url: "{{ url('checkout_failed', {order_id: order_id}) }}",
                        }),
                    });

                    const order = await response.json();

                    if (!response.ok) {
                        console.error('Error:', order.error.message);
                        return null;
                    }

                    const parsedOrder = JSON.parse(order);
                    return parsedOrder.id;

                } catch (error) {
                    console.error('Error:', error);
                    return null;
                }
            }

            async function capturePaypalOrder(orderId)
            {
                try {
                    const response = await fetch("/paypal/api/capture", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({
                            order_id: orderId
                        }),
                    });

                    const order = await response.json();

                    if (!response.ok) {
                        console.error('Error:', order.error.message);
                        return null;
                    }

                    const parsedOrder = JSON.parse(order);

                    if (parsedOrder.status === "COMPLETED") {
                        window.location.href = "{{ path('checkout_confirm') }}";
                    } else {
                        window.location.href = "{{ path('checkout_failed', {order_id: order_id}) }}";
                    }

                } catch (error) {
                    console.error('Error:', error);
                    return null;
                }
            }

            paypal.Buttons({
                createOrder: function(data, actions) {
                    return createPaypalOrder(orderId);
                },
                onApprove: function (data, actions) {
                    capturePaypalOrder(orderId);
                }
            }).render('#paypal-button-container');

        </script>
    {% endif %}
{% endblock %}
