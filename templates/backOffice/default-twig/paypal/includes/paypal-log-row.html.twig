<tr{% if log.hook %} style="cursor: pointer;"{% endif %}>
    <td>{{ log.createdAt ? log.createdAt|date('Y-m-d H:i:s') : '' }}</td>
    <td class="paypal-log" data-details="#details-{{ log.id }}">
        {% if log.hook %}
            {{ log.hook }}&nbsp;({{ 'See webhook details'|trans({}, 'paypal.bo.default') }})
            <div id="details-{{ log.id }}" class="d-none">
                {{ log.message|raw }}
            </div>
        {% else %}
            {{ log.message|raw }}
        {% endif %}
    </td>
    <td><a title="{{ 'Edit this customer'|trans }}" href="/admin/customer/update?customer_id={{ log.customerId }}">{{ log.customerId }}</a></td>
    <td><a href="/admin/order/update/{{ log.orderId }}">{{ log.orderId }}</a></td>
    <td><strong>{{ log.hook }}</strong></td>
    <td>{{ ('critical_' ~ log.level)|trans({}, 'paypal.bo.default') }}</td>
</tr>
